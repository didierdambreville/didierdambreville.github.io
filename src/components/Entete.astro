---
import { getCollection } from 'astro:content';
import { AUTEUR } from '../lib/identite';

const chemin = Astro.url.pathname;

// Une rubrique n'entre au menu que lorsqu'elle a quelque chose à montrer.
const nombre = async (c: 'articles' | 'realisations' | 'documents') =>
  (await getCollection(c, (e) => !e.data.brouillon)).length;
const [articles, realisations, documents] = await Promise.all([
  nombre('articles'),
  nombre('realisations'),
  nombre('documents'),
]);

// Ordre arrêté par l'auteur : Mémentos · Notes · Publications · Méthodes · Manifeste · À propos.
// « Publications » et « Méthodes » mènent, depuis le 2 octobre 2026, à deux pages du site qui
// présentent specula.fr et arscripta.fr et y renvoient (/publications/, /methodes/) ; elles
// menaient auparavant directement à ces sites. Dès le premier article publié ici, « Articles »
// (/articles/) s'insère avant « Publications ».
// « Manifeste » (TRIFAB, /manifeste/) et « Notes » (/notes/) ajoutés à la demande de
// l'auteur le 1er octobre 2026.
type Entree = { href: string; libelle: string; externe?: boolean };
const rubriques: Entree[] = [
  { href: '/mementos/', libelle: 'Mémentos' },
  { href: '/notes/', libelle: 'Notes' },
  ...(articles ? [{ href: '/articles/', libelle: 'Articles' }] : []),
  { href: '/publications/', libelle: 'Publications' },
  { href: '/methodes/', libelle: 'Méthodes' },
  ...(realisations ? [{ href: '/realisations/', libelle: 'Réalisations' }] : []),
  ...(documents ? [{ href: '/documents/', libelle: 'Documents' }] : []),
  { href: '/manifeste/', libelle: 'Manifeste' },
  { href: '/a-propos/', libelle: 'À propos' },
];
const actif = (r: Entree) => !r.externe && (chemin === r.href || chemin.startsWith(r.href));
---
<header class="bandeau">
  <div class="enveloppe bandeau__interieur">
    <a class="bandeau__nom" href="/">
      <img src="/logo-or.svg" alt="" width="32" height="32" />
      {AUTEUR}
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {
          rubriques.map((r) => (
            <li>
              <a href={r.href} aria-current={actif(r) ? 'page' : undefined}>
                {r.libelle}
                {r.externe && (
                  <>
                    <span class="externe" aria-hidden="true">↗</span>
                    <span class="lecteur-seul"> (site externe : {new URL(r.href).hostname})</span>
                  </>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

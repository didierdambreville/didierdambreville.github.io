---
import {
  ancre,
  dossiersADecouvrir,
  grouper,
  indexMotsCles,
  motsADecouvrir,
  motsEnVitrine,
  type Note,
} from '../lib/notes';

/**
 * Le panneau de /notes/, à la manière d'un gestionnaire de favoris : des dossiers, un
 * signet par note, puis les mots-clés. Aucun script — les dossiers se plient avec
 * <details>, que le navigateur gère seul.
 *
 * Sur une note, jamais la totalité, comme le panneau des articles : ses dossiers, ouverts
 * (la note en évidence, ses sections dépliées sous le dossier principal), puis quelques
 * autres à découvrir, repliés, pris d'abord du côté des notes voisines ; ses mots-clés,
 * puis quelques autres ; enfin un lien vers chaque liste complète. Sur /notes/, qui liste
 * déjà tout, les dossiers repliés et une sélection de mots-clés.
 */
interface Props {
  notes: Note[];
  /** Identifiant de la note affichée, s'il y en a une. */
  courante?: string;
  /** Sections de la note affichée. */
  sections?: { slug: string; text: string }[];
}
const { notes, courante, sections = [] } = Astro.props;
const tous = grouper(notes);
const note = notes.find((n) => n.id === courante);
const principal = note?.data.categories[0];

// Chaque groupe de dossiers : sa légende (aucune sur /notes/), ses dossiers, ouverts ou non.
const groupes = note
  ? [
      {
        id: 'dossiers-de-la-note',
        legende: 'De cette note',
        ouverts: true,
        dossiers: note.data.categories.flatMap((id) => tous.filter((g) => g.categorie.id === id)),
      },
      { id: 'dossiers-a-decouvrir', legende: 'À découvrir', ouverts: false, dossiers: dossiersADecouvrir(notes, note) },
    ]
  : [{ id: 'dossiers', legende: '', ouverts: false, dossiers: tous }];
const montres = groupes.reduce((s, g) => s + g.dossiers.length, 0);

const nombreMots = indexMotsCles(notes).length;
const sesMots = note?.data.motsCles ?? [];
const autresMots = note ? motsADecouvrir(notes, note, (n) => n.data.categories) : motsEnVitrine(notes);
---
<nav class="favoris" id="favoris" aria-label={note ? 'Dossiers et mots-clés des notes' : 'Toutes les notes'}>
  <p class="favoris__tete">
    <a href="/notes/">Notes</a>
    <span class="favoris__compte">{notes.length}</span>
  </p>

  {
    groupes.map(
      (groupe) =>
        groupe.dossiers.length > 0 && (
          <div role={groupe.legende ? 'group' : undefined} aria-labelledby={groupe.legende ? groupe.id : undefined}>
            {groupe.legende && <p class="favoris__legende favoris__legende--racine" id={groupe.id}>{groupe.legende}</p>}
            {groupe.dossiers.map(({ categorie, notes: contenu }) => (
              <details class="favoris__dossier" open={groupe.ouverts}>
                <summary>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M1.5 3.5h4.2l1.5 1.6h7.3v7.4H1.5z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                  <span>{categorie.nom}</span>
                  <span class="favoris__compte">{contenu.length}</span>
                </summary>
                <ul>
                  {contenu.map((n) => (
                    <li>
                      <a class="favoris__note" href={`/notes/${n.id}/`} aria-current={n.id === courante ? 'page' : undefined}>
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                          <path d="M4 1.8h8v12.4L8 11.3l-4 2.9z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                        </svg>
                        <span>{n.data.titre}</span>
                      </a>
                      {n.id === courante && categorie.id === principal && sections.length > 2 && (
                        <ul class="favoris__sections" aria-label="Sections de la note">
                          {sections.map((s) => (
                            <li>
                              <a href={`#${s.slug}`}>{s.text}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </div>
        ),
    )
  }
  {
    note && tous.length > montres && (
      <p class="favoris__tous favoris__tous--racine"><a href="/notes/#dossiers">Les {tous.length} dossiers</a></p>
    )
  }

  <details class="favoris__dossier" open>
    <summary>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1.8 1.8h6l6.4 6.4-6 6-6.4-6.4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        <circle cx="5" cy="5" r="1.1" fill="currentColor" />
      </svg>
      <span>Mots-clés</span>
    </summary>
    {
      sesMots.length > 0 && (
        <>
          <p class="favoris__legende" id="mots-de-la-note">De cette note</p>
          <ul class="mots favoris__mots" aria-labelledby="mots-de-la-note">
            {sesMots.map((mot) => (
              <li><a href={`/notes/mots-cles/#${ancre(mot)}`} class="mots__courant">{mot}</a></li>
            ))}
          </ul>
        </>
      )
    }
    {
      autresMots.length > 0 && (
        <>
          {note && <p class="favoris__legende" id="mots-a-decouvrir">À découvrir</p>}
          <ul class="mots favoris__mots" aria-labelledby={note ? 'mots-a-decouvrir' : undefined}>
            {autresMots.map((mot) => (
              <li><a href={`/notes/mots-cles/#${ancre(mot)}`}>{mot}</a></li>
            ))}
          </ul>
        </>
      )
    }
    {
      nombreMots > sesMots.length + autresMots.length && (
        <p class="favoris__tous"><a href="/notes/mots-cles/">Les {nombreMots} mots-clés</a></p>
      )
    }
  </details>
</nav>

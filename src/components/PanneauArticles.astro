---
import { motsClesADecouvrir, rubriquesADecouvrir, rubriquesPresentes, type Article } from '../lib/articles';
import { ancre, indexMotsCles } from '../lib/notes';

/**
 * Le panneau de droite d'un article, de même facture que celui des notes. Deux dossiers,
 * bâtis de la même façon : ce qui appartient à l'article lu (en évidence), puis quelques
 * autres à découvrir, pris d'abord du côté des articles voisins — jamais la totalité —, et
 * un lien vers la liste complète : les filtres de /articles/ pour les rubriques, l'index
 * /articles/mots-cles/ pour les mots-clés. Aucun script : les dossiers se plient avec
 * <details>. Sur mobile, il passe sous le texte.
 */
interface Props {
  articles: Article[];
  /** L'article affiché. */
  courant: Article;
}
const { articles, courant } = Astro.props;
const rubriques = rubriquesPresentes(articles);
// Celles de l'article dans son ordre à lui (la principale d'abord), avec leur compte.
const sesRubriques = courant.data.rubriques.flatMap((id) => rubriques.filter((r) => r.id === id));
const rubriquesAutres = rubriquesADecouvrir(articles, courant);
const sesMots = courant.data.motsCles;
const aDecouvrir = motsClesADecouvrir(articles, courant);
const nombreMots = indexMotsCles(articles).length;
---
<nav class="favoris" id="panneau" aria-label="Rubriques et mots-clés des articles">
  <p class="favoris__tete">
    <a href="/articles/">Articles</a>
    <span class="favoris__compte">{articles.length}</span>
  </p>

  <details class="favoris__dossier" open>
    <summary>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1.5 3.5h4.2l1.5 1.6h7.3v7.4H1.5z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
      </svg>
      <span>Rubriques</span>
    </summary>
    {
      [
        { id: 'rubriques-de-l-article', legende: 'De cet article', liste: sesRubriques, courant: true },
        { id: 'rubriques-a-decouvrir', legende: 'À découvrir', liste: rubriquesAutres, courant: false },
      ].map(
        (groupe) =>
          groupe.liste.length > 0 && (
            <>
              <p class="favoris__legende" id={groupe.id}>{groupe.legende}</p>
              <ul aria-labelledby={groupe.id}>
                {groupe.liste.map((r) => (
                  <li>
                    <a
                      class="favoris__note"
                      href={`/articles/rubrique/${r.id}/`}
                      aria-current={groupe.courant ? 'true' : undefined}
                    >
                      <svg viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M4 1.8h8v12.4L8 11.3l-4 2.9z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                      </svg>
                      <span>{r.nom}</span>
                      <span class="favoris__compte">{r.articles.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ),
      )
    }
    {
      rubriques.length > sesRubriques.length + rubriquesAutres.length && (
        <p class="favoris__tous"><a href="/articles/#rubriques">Les {rubriques.length} rubriques</a></p>
      )
    }
  </details>

  <details class="favoris__dossier" open>
    <summary>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1.8 1.8h6l6.4 6.4-6 6-6.4-6.4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
        <circle cx="5" cy="5" r="1.1" fill="currentColor" />
      </svg>
      <span>Mots-clés</span>
    </summary>
    {
      sesMots.length > 0 && (
        <>
          <p class="favoris__legende" id="mots-de-l-article">De cet article</p>
          <ul class="mots favoris__mots" aria-labelledby="mots-de-l-article">
            {sesMots.map((mot) => (
              <li><a href={`/articles/mots-cles/#${ancre(mot)}`} class="mots__courant">{mot}</a></li>
            ))}
          </ul>
        </>
      )
    }
    {
      aDecouvrir.length > 0 && (
        <>
          <p class="favoris__legende" id="mots-a-decouvrir">À découvrir</p>
          <ul class="mots favoris__mots" aria-labelledby="mots-a-decouvrir">
            {aDecouvrir.map((mot) => (
              <li><a href={`/articles/mots-cles/#${ancre(mot)}`}>{mot}</a></li>
            ))}
          </ul>
        </>
      )
    }
    {
      nombreMots > sesMots.length + aDecouvrir.length && (
        <p class="favoris__tous"><a href="/articles/mots-cles/">Les {nombreMots} mots-clés</a></p>
      )
    }
  </details>
</nav>

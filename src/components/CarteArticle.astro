---
import { type Article, minutesLecture, rubriquesDe } from '../lib/articles';
import { dateNote } from '../lib/notes';

/**
 * Un article en carte-titre horizontale (16:9) : surtitre, titre, thèse, date. Ses
 * rubriques suivent la carte, hors du lien — un lien ne peut pas en contenir d'autres —
 * et chacune mène à sa page. Les mots-clés ne s'affichent pas ici : une sélection figure
 * en bas de /articles/, l'index complet sur /articles/mots-cles/.
 */
interface Props {
  a: Article;
}
const { a } = Astro.props;
const d = a.data;
const rubriques = rubriquesDe(a);
---
<li class="carte-titre carte-titre--article">
  <a href={`/articles/${a.id}/`} aria-label={`Article — ${d.titre}`}>
    <span class="carte-titre__surtitre">Article</span>
    <span class="carte-titre__titre">{d.titre}</span>
    <span class="carte-titre__filet" aria-hidden="true"></span>
    <span class="carte-titre__sous">{d.these}</span>
    <span class="carte-titre__pied">{dateNote(d.date)} · {minutesLecture(a)}&#160;min</span>
    <img class="carte-titre__logo" src="/logo-or.svg" alt="" width="20" height="20" />
  </a>
  <p class="carte-titre__rubrique">
    {rubriques.length > 1 ? 'Rubriques' : 'Rubrique'}
    {rubriques.map((r, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`/articles/rubrique/${r.id}/`}>{r.nom}</a></>)}
  </p>
</li>

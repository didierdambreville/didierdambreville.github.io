---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { mementosPublies, grouper as grouperMementos } from '../lib/mementos';
import { affichesPubliees } from '../lib/affiches';
import { notesPubliees, grouper as grouperNotes, grouperParPrincipal } from '../lib/notes';
import { MANIFESTE, documentsManifeste } from '../lib/manifeste';
import { AUTEUR, RESEAUX, ARSCRIPTA, SPECULA, DEPOT_PRAXIS, LICENCE } from '../lib/identite';

/**
 * L'accueil résume le site : tout y est calculé à partir de ce qui est publié — nombres,
 * familles, dossiers, titres. Une pièce ajoutée ailleurs y apparaît d'elle-même.
 */
const mementos = await mementosPublies();
const familles = grouperMementos(mementos);
const pagesMementos = mementos.reduce((n, m) => n + m.data.pages, 0);
const affiches = await affichesPubliees();
const formatsAffiches = [...new Set(affiches.map((a) => a.data.format))].sort().join(' et ');
const notes = await notesPubliees();
const dossiers = grouperNotes(notes);
// Le résumé de l'accueil range chaque note une fois, sous son dossier principal.
const dossiersPrincipaux = grouperParPrincipal(notes);
const documents = documentsManifeste();

const articles = (await getCollection('articles', (e) => !e.data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const chiffres = [
  { nombre: mementos.length, libelle: 'mémentos', detail: `${pagesMementos} pages A4`, href: '#mementos' },
  { nombre: notes.length, libelle: 'notes', detail: `en ${dossiers.length} dossiers`, href: '#notes' },
  { nombre: affiches.length, libelle: 'affiches', detail: formatsAffiches, href: '#affiches' },
  { nombre: documents.length, libelle: 'documents', detail: `manifeste ${MANIFESTE.nom}`, href: '#manifeste' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTEUR,
  url: Astro.site?.href,
  sameAs: RESEAUX.map((r) => r.url),
  founder: [
    { '@type': 'Organization', name: ARSCRIPTA.nom, url: ARSCRIPTA.url },
    { '@type': 'Organization', name: SPECULA.nom, url: SPECULA.url },
  ],
};
---
<Base
  titre={AUTEUR}
  description={`${mementos.length} mémentos imprimables, ${affiches.length} affiches, ${notes.length} notes publiques et le manifeste ${MANIFESTE.nom}, en libre accès sous licence CC BY 4.0.`}
  jsonLd={jsonLd}
>
  <header class="ac-tete">
    <img src="/logo-or.svg" alt="" width="120" height="120" />
    <div>
      <h1>{AUTEUR}</h1>
      <p class="ac-tete__sous">
        Des aide-mémoire à imprimer, des notes publiques, un manifeste — en libre accès.
      </p>
      <p class="ac-tete__meta">
        Fondateur d'<a href={ARSCRIPTA.url}>ARSCRIPTA</a>, méthodes de travail, et de
        <a href={SPECULA.url}>{SPECULA.marque}</a>, analyses macro-financières · tout le contenu est sous licence
        <a href={LICENCE.url} rel="license">CC&#160;BY&#160;4.0</a>
      </p>
    </div>
  </header>

  <ul class="ac-chiffres" aria-label="Le site en chiffres">
    {
      chiffres.map((c) => (
        <li>
          <a href={c.href}>
            <span class="ac-chiffres__nombre">{c.nombre}</span>
            <span class="ac-chiffres__libelle">{c.libelle}</span>
            <span class="ac-chiffres__detail">{c.detail}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="ac-rubriques">
    <div class="ac-colonne">
      <section class="ac-bloc ac-bloc--large" id="mementos" aria-labelledby="titre-mementos">
        <h2 id="titre-mementos"><a href="/mementos/">Mémentos</a></h2>
        <p class="ac-bloc__chapeau">
          L'essentiel d'un sujet en six à huit pages A4, en noir et blanc, à imprimer. Chacun est
          fourni en PDF et en source HTML modifiable.
        </p>
        <dl class="ac-liste">
          {
            familles.map(({ famille, rubriques }) => (
              <div>
                <dt>{famille.nom}</dt>
                <dd>
                  {rubriques
                    .flatMap((r) => r.mementos)
                    .map((m, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={`/mementos/${m.id}/`}>{m.data.titre}</a>
                      </>
                    ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="ac-bloc__suite"><a href="/mementos/">Tous les mémentos →</a></p>
      </section>

      {
        affiches.length > 0 && (
          <section class="ac-bloc" id="affiches" aria-labelledby="titre-affiches">
            <h2 id="titre-affiches"><a href="/mementos/#affiches">Affiches</a></h2>
            <p class="ac-bloc__chapeau">
              L'essentiel d'un mémento sur une page A3 en couleur, pour le mur d'un atelier ou d'un
              fablab — et une énigme en Python pour le Wi-Fi des invités.
            </p>
            <ul class="ac-puces">
              {affiches.map((a) => (
                <li>
                  <a href={`/affiches/${a.id}/`}>{a.data.titre}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="ac-colonne">
      <section class="ac-bloc ac-bloc--large" id="notes" aria-labelledby="titre-notes">
        <h2 id="titre-notes"><a href="/notes/">Notes</a></h2>
        <p class="ac-bloc__chapeau">
          Bibliographies, listes, circuits, relevés : l'essentiel d'un sujet, tenu à jour et rangé
          comme des favoris.
        </p>
        <dl class="ac-liste">
          {
            dossiersPrincipaux.map(({ categorie, notes }) => (
              <div>
                <dt>{categorie.nom}</dt>
                <dd>
                  {notes.map((n, i) => (
                    <>
                      {i > 0 && ' · '}
                      <a href={`/notes/${n.id}/`}>{n.data.titre}</a>
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="ac-bloc__suite"><a href="/notes/">Toutes les notes →</a></p>
      </section>

      <section class="ac-bloc ac-bloc--nuit" id="manifeste" aria-labelledby="titre-manifeste">
        <div class="ac-manifeste">
          <img src={MANIFESTE.logo} alt="" width="72" height="72" />
          <div>
            <h2 id="titre-manifeste"><a href="/manifeste/">Manifeste {MANIFESTE.nom}</a></h2>
            <p class="ac-manifeste__punch">{MANIFESTE.punchline}</p>
          </div>
        </div>
        <p class="ac-bloc__chapeau">
          {MANIFESTE.chaine} : ajouter à la déchetterie une ressourcerie qui trie et remet en
          circulation, et un fablab qui répare et transforme. Un projet à porter devant ses élus.
        </p>
        <ul class="ac-puces">
          {
            documents.map((d) => (
              <li>
                <a href={d.url} download>{d.titre}</a>
                {d.pages && <span class="ac-puces__glose"> — {d.pages}&#160;pages</span>}
              </li>
            ))
          }
        </ul>
        <p class="ac-bloc__suite"><a href="/manifeste/">Lire le manifeste →</a></p>
      </section>
    </div>
  </div>

  {
    articles.length > 0 && (
      <section aria-labelledby="titre-articles">
        <h2 id="titre-articles">Derniers articles</h2>
        <ol class="sommaire sommaire--serre">
          {articles.map((a) => (
            <li>
              <p class="etiquette">
                {a.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long' })}
              </p>
              <h3><a href={`/articles/${a.id}/`}>{a.data.titre}</a></h3>
              <p class="sommaire__these">{a.data.these}</p>
            </li>
          ))}
        </ol>
        <p class="liens"><a href="/articles/">Tous les articles</a></p>
      </section>
    )
  }

  <section aria-labelledby="titre-ailleurs">
    <h2 id="titre-ailleurs">Ailleurs</h2>
    <ul class="ailleurs">
      <li>
        <h3><a href={SPECULA.url}>Articles — specula.fr</a></h3>
        <p>Analyses macro-financières et La Note Sentinelle.</p>
      </li>
      <li>
        <h3><a href={ARSCRIPTA.methodes}>Méthodes — arscripta.fr</a></h3>
        <p>
          Quatre méthodes de travail publiées sous licences ouvertes&#160;: RCUP pour classer, TELOS
          pour conduire un projet, SOBRE pour instruire un assistant IA, et PRAXIS, qui les réunit.
        </p>
      </li>
      <li>
        <h3><a href={RESEAUX[2].url}>Code — GitHub</a></h3>
        <p>
          Dépôts publics, dont <a href={DEPOT_PRAXIS}>la méthode PRAXIS</a>, versée au domaine
          public.
        </p>
      </li>
      <li>
        <h3>Réseaux</h3>
        <p>
          <a href={RESEAUX[0].url} rel="me">X — {RESEAUX[0].libelle}</a><br />
          <a href={RESEAUX[1].url} rel="me">LinkedIn</a>
        </p>
      </li>
    </ul>
  </section>
</Base>

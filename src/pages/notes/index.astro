---
import Base from '../../layouts/Base.astro';
import PanneauNotes from '../../components/PanneauNotes.astro';
import ListeNotes from '../../components/ListeNotes.astro';
import { notesPubliees, grouper, grouperParPrincipal, indexMotsCles, ancre, motsEnVitrine } from '../../lib/notes';
import { AUTEUR, LICENCE } from '../../lib/identite';

const notes = await notesPubliees();
const dossiers = grouper(notes);
// Chaque note une seule fois, sous son dossier principal ; la page d'un dossier les donne toutes.
const parPrincipal = grouperParPrincipal(notes);
// Une sélection seulement : l'index complet a sa page, /notes/mots-cles/.
const vitrine = motsEnVitrine(notes);
const nombreMots = indexMotsCles(notes).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Notes',
  description: 'Notes publiques tenues à jour : bibliographies, listes, relevés.',
  url: new URL('/notes/', Astro.site).href,
  author: { '@type': 'Person', name: AUTEUR, url: Astro.site?.href },
  license: LICENCE.urlCanonique,
  hasPart: notes.map((n) => ({
    '@type': 'CreativeWork',
    name: n.data.titre,
    url: new URL(`/notes/${n.id}/`, Astro.site).href,
  })),
};
---
<Base
  titre={`Notes — ${AUTEUR}`}
  description={`${notes.length} notes publiques tenues à jour — bibliographies, listes, relevés —, rangées par dossier et par mot-clé.`}
  jsonLd={jsonLd}
>
  <div class="notes notes--index">
    <div class="notes__contenu">
      <h1>Notes</h1>
      <p class="chapeau">
        Des notes publiques tenues à jour&#160;: bibliographies, listes, relevés. Pas des
        articles — l'essentiel d'un sujet, à consulter plutôt qu'à lire d'une traite. Rangées par
        dossier, retrouvées par mot-clé.
      </p>

      <ul class="filtres" id="dossiers" aria-label="Dossiers">
        <li><a href="/notes/" aria-current="true">Toutes</a></li>
        {dossiers.map(({ categorie }) => (
          <li><a href={`/notes/dossier/${categorie.id}/`}>{categorie.nom}</a></li>
        ))}
      </ul>

      {
        parPrincipal.map(({ categorie, notes }) => (
          <section aria-labelledby={`dossier-${categorie.id}`}>
            <h2 id={`dossier-${categorie.id}`}>{categorie.nom}</h2>
            <ListeNotes notes={notes} dossier={categorie.id} />
          </section>
        ))
      }

      {
        vitrine.length > 0 && (
          <section class="vitrine-mots" aria-labelledby="titre-mots-cles">
            <h2 id="titre-mots-cles">Mots-clés</h2>
            <ul class="mots">
              {vitrine.map((m) => (
                <li><a href={`/notes/mots-cles/#${ancre(m)}`}>{m}</a></li>
              ))}
            </ul>
            {nombreMots > vitrine.length && (
              <p class="liens">
                <a href="/notes/mots-cles/">Les {nombreMots} mots-clés</a>
              </p>
            )}
          </section>
        )
      }
    </div>

    <PanneauNotes notes={notes} />
  </div>
</Base>

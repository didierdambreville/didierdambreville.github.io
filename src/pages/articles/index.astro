---
import Base from '../../layouts/Base.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import { AUTEUR } from '../../lib/identite';
import { articlesPublies, motsClesEnVitrine, rubriquesPresentes } from '../../lib/articles';
import { ancre, indexMotsCles } from '../../lib/notes';

const articles = await articlesPublies();

// Regroupement par année : un corpus se lit par vagues, pas en liste plate.
const annees = [...new Set(articles.map((a) => a.data.date.getFullYear()))].sort((a, b) => b - a);
const presentes = rubriquesPresentes(articles);
// Une sélection seulement : l'index complet a sa page, /articles/mots-cles/.
const vitrine = motsClesEnVitrine(articles);
const nombreMots = indexMotsCles(articles).length;
---
<Base
  titre={`Articles — ${AUTEUR}`}
  description="Textes courts : méthode, intelligence artificielle, robotique, informatique, sciences, travail, écologie."
>
  <h1>Articles</h1>
  <p class="chapeau">
    Des textes courts. Chacun tient sur une thèse énoncée en une phrase&#160;; le reste n'est là que
    pour la soutenir ou la mettre à l'épreuve.
  </p>

  {
    presentes.length > 1 && (
      <ul class="filtres" id="rubriques" aria-label="Rubriques">
        <li><a href="/articles/" aria-current="true">Tous</a></li>
        {presentes.map((r) => (
          <li><a href={`/articles/rubrique/${r.id}/`}>{r.nom}</a></li>
        ))}
      </ul>
    )
  }

  {
    articles.length === 0 ? (
      <p>Aucun article publié pour l'instant.</p>
    ) : (
      annees.map((annee) => (
        <section aria-labelledby={`annee-${annee}`}>
          <h2 id={`annee-${annee}`}>{annee}</h2>
          <ul class="grille grille--articles">
            {articles
              .filter((a) => a.data.date.getFullYear() === annee)
              .map((a) => <CarteArticle a={a} />)}
          </ul>
        </section>
      ))
    )
  }

  {
    vitrine.length > 0 && (
      <section class="vitrine-mots" aria-labelledby="titre-mots-cles">
        <h2 id="titre-mots-cles">Mots-clés</h2>
        <ul class="mots">
          {vitrine.map((m) => (
            <li><a href={`/articles/mots-cles/#${ancre(m)}`}>{m}</a></li>
          ))}
        </ul>
        {nombreMots > vitrine.length && (
          <p class="liens">
            <a href="/articles/mots-cles/">Les {nombreMots} mots-clés</a>
          </p>
        )}
      </section>
    )
  }
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { AUTEUR } from '../../lib/identite';
import { RUBRIQUES, LIBELLES_RUBRIQUE } from '../../content.config';

const articles = (await getCollection('articles', (e) => !e.data.brouillon)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Regroupement par année : un corpus se lit par vagues, pas en liste plate.
const annees = [...new Set(articles.map((a) => a.data.date.getFullYear()))].sort((a, b) => b - a);
const presentes = RUBRIQUES.filter((r) => articles.some((a) => a.data.rubrique === r));
---
<Base
  titre={`Articles — ${AUTEUR}`}
  description="Textes courts : méthode, vérification des sources, héritage, sciences, livres."
>
  <h1>Articles</h1>
  <p class="chapeau">
    Des textes courts. Chacun tient sur une thèse énoncée en une phrase&#160;; le reste n'est là que
    pour la soutenir ou la mettre à l'épreuve.
  </p>

  {
    presentes.length > 1 && (
      <ul class="filtres">
        <li><a href="/articles/" aria-current="true">Tous</a></li>
        {presentes.map((r) => (
          <li><a href={`/articles/rubrique/${r}/`}>{LIBELLES_RUBRIQUE[r]}</a></li>
        ))}
      </ul>
    )
  }

  {
    articles.length === 0 ? (
      <p>Aucun article publié pour l'instant.</p>
    ) : (
      annees.map((annee) => (
        <section>
          <h2>{annee}</h2>
          <ol class="sommaire">
            {articles
              .filter((a) => a.data.date.getFullYear() === annee)
              .map((a) => (
                <li>
                  <p class="etiquette">
                    {LIBELLES_RUBRIQUE[a.data.rubrique]} ·{' '}
                    {a.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}
                  </p>
                  <h3><a href={`/articles/${a.id}/`}>{a.data.titre}</a></h3>
                  <p class="sommaire__these">{a.data.these}</p>
                </li>
              ))}
          </ol>
        </section>
      ))
    )
  }
</Base>

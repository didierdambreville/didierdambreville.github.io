---
import Base from '../../layouts/Base.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import { AUTEUR } from '../../lib/identite';
import { articlesPublies, rubriquesPresentes } from '../../lib/articles';
import { indexMotsCles } from '../../lib/notes';

const articles = await articlesPublies();

// Regroupement par année : un corpus se lit par vagues, pas en liste plate.
const annees = [...new Set(articles.map((a) => a.data.date.getFullYear()))].sort((a, b) => b - a);
const presentes = rubriquesPresentes(articles);
const mots = indexMotsCles(articles);
---
<Base
  titre={`Articles — ${AUTEUR}`}
  description="Textes courts : méthode, vérification des sources, héritage, sciences, livres."
>
  <h1>Articles</h1>
  <p class="chapeau">
    Des textes courts. Chacun tient sur une thèse énoncée en une phrase&#160;; le reste n'est là que
    pour la soutenir ou la mettre à l'épreuve.
  </p>

  {
    presentes.length > 1 && (
      <ul class="filtres">
        <li><a href="/articles/" aria-current="true">Tous</a></li>
        {presentes.map((r) => (
          <li><a href={`/articles/rubrique/${r.id}/`}>{r.nom}</a></li>
        ))}
      </ul>
    )
  }

  {
    articles.length === 0 ? (
      <p>Aucun article publié pour l'instant.</p>
    ) : (
      annees.map((annee) => (
        <section aria-labelledby={`annee-${annee}`}>
          <h2 id={`annee-${annee}`}>{annee}</h2>
          <ul class="grille grille--articles">
            {articles
              .filter((a) => a.data.date.getFullYear() === annee)
              .map((a) => <CarteArticle a={a} />)}
          </ul>
        </section>
      ))
    )
  }

  {
    mots.length > 0 && (
      <section id="mots-cles" aria-labelledby="titre-mots-cles">
        <h2 id="titre-mots-cles">Mots-clés</h2>
        <dl class="index-mots">
          {mots.map(({ mot, ancre, notes: liste }) => (
            <div id={ancre}>
              <dt>{mot}</dt>
              <dd>
                {liste.map((a, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={`/articles/${a.id}/`}>{a.data.titre}</a>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</Base>

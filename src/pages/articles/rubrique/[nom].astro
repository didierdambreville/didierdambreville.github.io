---
import Base from '../../../layouts/Base.astro';
import CarteArticle from '../../../components/CarteArticle.astro';
import { articlesPublies, rubriquesPresentes } from '../../../lib/articles';

export async function getStaticPaths() {
  const presentes = rubriquesPresentes(await articlesPublies());
  return presentes.map((r) => ({ params: { nom: r.id }, props: { rubrique: r, presentes } }));
}

const { rubrique, presentes } = Astro.props;
---
<Base titre={`${rubrique.nom} — Articles`} description={`Les articles de la rubrique « ${rubrique.nom} ».`}>
  <p class="etiquette"><a href="/articles/">Articles</a></p>
  <h1>{rubrique.nom}</h1>

  {/* Seules les rubriques qui ont des articles : les autres n'ont pas de page. */}
  <ul class="filtres">
    <li><a href="/articles/">Tous</a></li>
    {
      presentes.map((r) => (
        <li>
          <a href={`/articles/rubrique/${r.id}/`} aria-current={r.id === rubrique.id ? 'true' : undefined}>
            {r.nom}
          </a>
        </li>
      ))
    }
  </ul>

  <ul class="grille grille--articles">
    {rubrique.articles.map((a) => <CarteArticle a={a} />)}
  </ul>
</Base>

---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { AUTEUR } from '../lib/identite';
import portrait from '../assets/portrait.png';

const entree = await getEntry('pages', 'a-propos');
if (!entree) throw new Error('src/data/pages/a-propos.md est absent.');
const { Content } = await render(entree);
---
<Base
  titre={`${entree.data.titre} — ${AUTEUR}`}
  description={entree.data.description}
  image={portrait}
  imageAlt={`Portrait de ${AUTEUR}`}
>
  <h1>{entree.data.titre}</h1>
  <div class="presentation">
    <figure class="presentation__portrait">
      <Image
        src={portrait}
        alt={`Portrait de ${AUTEUR}`}
        widths={[240, 360, 480]}
        sizes="(max-width: 40rem) 60vw, 240px"
        loading="eager"
      />
    </figure>
    <div class="presentation__texte">
      <Content />
    </div>
  </div>
</Base>

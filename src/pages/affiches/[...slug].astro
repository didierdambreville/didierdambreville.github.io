---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { affichesPubliees, urlPdfAffiche, urlSourceAffiche, teinte, LANGUES } from '../../lib/affiches';
import { mementosPublies, poids, dateFr } from '../../lib/mementos';
import { verifierIdentifiants } from '../../lib/identifiants';
import { AUTEUR, LICENCE } from '../../lib/identite';

export async function getStaticPaths() {
  const affiches = await affichesPubliees();
  verifierIdentifiants(affiches);
  const mementos = await mementosPublies();
  const titres = new Map(mementos.map((m) => [m.id, m.data.titre]));
  return affiches.map((a) => {
    // Une affiche renvoie à des mémentos : un renvoi vers une page absente échoue à la construction.
    const absents = [...a.data.mementos, ...a.data.renvois].filter((id) => !titres.has(id));
    if (absents.length)
      throw new Error(`Affiche « ${a.id} » : mémento(s) inconnu(s) ou non publié(s) : ${absents.join(', ')}.`);
    const lier = (ids: string[]) => ids.map((id) => ({ id, titre: titres.get(id) as string }));
    return { params: { slug: a.id }, props: { a, sources: lier(a.data.mementos), renvois: lier(a.data.renvois) } };
  });
}

const { a, sources, renvois } = Astro.props;
const d = a.data;
const pdf = urlPdfAffiche(a.id);
const source = urlSourceAffiche(a.id);
const poidsPdf = poids(pdf);
const adresse = new URL(`/affiches/${a.id}/`, Astro.site).href;
const moisVersion = dateFr(d.date, false);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: `Affiche — ${d.titre}`,
  alternativeHeadline: d.sousTitre,
  description: d.resume,
  learningResourceType: 'Affiche',
  inLanguage: d.langue,
  author: { '@type': 'Person', name: AUTEUR, url: Astro.site?.href },
  license: LICENCE.urlCanonique,
  isAccessibleForFree: true,
  version: d.version,
  datePublished: (d.premiereEdition ?? d.date).toISOString().slice(0, 10),
  dateModified: d.date.toISOString().slice(0, 10),
  url: adresse,
  isBasedOn: sources.length ? sources.map((s) => new URL(`/mementos/${s.id}/`, Astro.site).href) : undefined,
  encoding: [
    { '@type': 'MediaObject', contentUrl: new URL(pdf, Astro.site).href, encodingFormat: 'application/pdf' },
    ...(d.source
      ? [{ '@type': 'MediaObject', contentUrl: new URL(source, Astro.site).href, encodingFormat: 'text/html' }]
      : []),
  ],
};
---
<Base
  titre={`Affiche — ${d.titre} · ${AUTEUR}`}
  description={d.resume}
  jsonLd={jsonLd}
  image={d.couverture}
  imageAlt={d.couvertureAlt}
>
  <p class="etiquette">
    <a href="/mementos/">Mémentos</a> › <a href="/mementos/#affiches">Affiches</a>
  </p>
  <h1>{d.titre}</h1>
  <p class="chapeau">{d.sousTitre}</p>

  <div class="memento">
    <figure class="memento__couverture">
      <a href={pdf}>
        <Image
          src={d.couverture}
          alt={d.couvertureAlt}
          widths={[280, 420, 560]}
          sizes="(max-width: 40rem) 70vw, 280px"
          loading="eager"
        />
      </a>
    </figure>

    <div class="memento__notice">
      <p>{d.resume}</p>
      <dl class="meta">
        <dt>Auteur</dt><dd>{AUTEUR}</dd>
        <dt>Version</dt><dd>{d.version} — {dateFr(d.date)}</dd>
        {d.premiereEdition && <><dt>Première édition</dt><dd>{dateFr(d.premiereEdition)}</dd></>}
        <dt>Format</dt><dd>{d.format}, {teinte(a)}, une page</dd>
        {d.langue !== 'fr' && <><dt>Langue</dt><dd>{LANGUES[d.langue]}</dd></>}
        {
          sources.length > 0 && (
            <>
              <dt>Tirée de</dt>
              <dd>
                {sources.map((s, i) => (
                  <>{i > 0 && ', '}<a href={`/mementos/${s.id}/`}>mémento « {s.titre} »</a></>
                ))}
              </dd>
            </>
          )
        }
        {
          renvois.length > 0 && (
            <>
              <dt>Pour aller plus loin</dt>
              <dd>
                {renvois.map((s, i) => (
                  <>{i > 0 && ', '}<a href={`/mementos/${s.id}/`}>mémento « {s.titre} »</a></>
                ))}
              </dd>
            </>
          )
        }
        <dt>Licence</dt><dd><a href={LICENCE.url} rel="license">{LICENCE.nom}</a></dd>
      </dl>
      <p class="actions">
        <a class="telecharger" href={pdf} download>
          Télécharger le PDF{poidsPdf && <span class="actions__poids"> ({poidsPdf})</span>}
        </a>
        {d.source && <a class="actions__secondaire" href={source} download>Source HTML modifiable</a>}
      </p>
    </div>
  </div>

  {
    d.blocs.length > 0 && (
      <>
        <h2>Les blocs</h2>
        <ol class="sommaire-memento">
          {d.blocs.map((intitule) => <li>{intitule}</li>)}
        </ol>
      </>
    )
  }

  <h2>Imprimer, réutiliser et citer</h2>
  <p>
    L'affiche s'imprime au format {d.format}, à taille réelle, marges nulles et arrière-plans activés. Elle
    est publiée sous licence <a href={LICENCE.url} rel="license">{LICENCE.intitule}</a>&#160;: vous
    pouvez la copier, l'imprimer, la distribuer, la modifier et la réutiliser, y compris à des fins
    commerciales, à deux conditions&#160;: citer l'auteur et signaler vos modifications.
    {
      sources.length > 0 && (
        <>
          Les sources et le degré de vérification de son contenu sont ceux du mémento dont elle est
          tirée&#160;; ils sont rappelés en pied de page.
        </>
      )
    }
  </p>
  <p>Pour la citer&#160;:</p>
  <p class="citation">
    {AUTEUR}, <cite>Affiche — {d.titre}</cite>, version {d.version}, {moisVersion}, {adresse},
    licence {LICENCE.nom}.
  </p>

  <p class="liens"><a href="/mementos/#affiches">← Toutes les affiches</a></p>
</Base>

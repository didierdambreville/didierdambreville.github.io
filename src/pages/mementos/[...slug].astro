---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { mementosPublies, urlPdf, urlSource, poids, dateFr } from '../../lib/mementos';
import { situer } from '../../lib/classement-mementos';
import { verifierIdentifiants } from '../../lib/identifiants';
import { AUTEUR, LICENCE } from '../../lib/identite';

export async function getStaticPaths() {
  const mementos = await mementosPublies();
  verifierIdentifiants(mementos);
  return mementos.map((m) => ({ params: { slug: m.id }, props: { m } }));
}

const { m } = Astro.props;
const d = m.data;
const { famille, rubrique } = situer(d.rubrique);
const pdf = urlPdf(m.id);
const source = urlSource(m.id);
const poidsPdf = poids(pdf);
const adresse = new URL(`/mementos/${m.id}/`, Astro.site).href;
const moisVersion = dateFr(d.date, false);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: `Mémento — ${d.titre}`,
  alternativeHeadline: d.sousTitre,
  description: d.resume,
  learningResourceType: 'Aide-mémoire',
  inLanguage: 'fr',
  author: { '@type': 'Person', name: AUTEUR, url: Astro.site?.href },
  license: LICENCE.urlCanonique,
  isAccessibleForFree: true,
  version: d.version,
  datePublished: d.premiereEdition.toISOString().slice(0, 10),
  dateModified: d.date.toISOString().slice(0, 10),
  about: rubrique.nom,
  url: adresse,
  encoding: [
    { '@type': 'MediaObject', contentUrl: new URL(pdf, Astro.site).href, encodingFormat: 'application/pdf' },
    { '@type': 'MediaObject', contentUrl: new URL(source, Astro.site).href, encodingFormat: 'text/html' },
  ],
};
---
<Base
  titre={`Mémento — ${d.titre} · ${AUTEUR}`}
  description={d.resume}
  jsonLd={jsonLd}
  image={d.couverture}
  imageAlt={d.couvertureAlt}
>
  <p class="etiquette">
    <a href="/mementos/">Mémentos</a> · {famille.nom}{rubrique.nom !== famille.nom && <> › {rubrique.nom}</>}
  </p>
  <h1>{d.titre}</h1>
  <p class="chapeau">{d.sousTitre}</p>

  <div class="memento">
    <figure class="memento__couverture">
      <a href={pdf}>
        <Image
          src={d.couverture}
          alt={d.couvertureAlt}
          widths={[280, 420, 560]}
          sizes="(max-width: 40rem) 70vw, 280px"
          loading="eager"
        />
      </a>
    </figure>

    <div class="memento__notice">
      <p>{d.resume}</p>
      <dl class="meta">
        <dt>Auteur</dt><dd>{AUTEUR}</dd>
        <dt>Version</dt><dd>{d.version} — {dateFr(d.date)}</dd>
        <dt>Première édition</dt><dd>{dateFr(d.premiereEdition)}</dd>
        <dt>Format</dt><dd>A4, noir et blanc, {d.pages}&#160;pages</dd>
        <dt>Licence</dt><dd><a href={LICENCE.url} rel="license">{LICENCE.nom}</a></dd>
      </dl>
      <p class="actions">
        <a class="telecharger" href={pdf} download>
          Télécharger le PDF{poidsPdf && <span class="actions__poids"> ({poidsPdf})</span>}
        </a>
        <a class="actions__secondaire" href={source} download>Source HTML modifiable</a>
      </p>
    </div>
  </div>

  <h2>Sommaire</h2>
  <ol class="sommaire-memento">
    {d.sommaire.map((intitule) => <li>{intitule}</li>)}
  </ol>

  <h2>Réutiliser et citer</h2>
  <p>
    Ce mémento est publié sous licence
    <a href={LICENCE.url} rel="license">{LICENCE.intitule}</a>. Vous pouvez le copier, l'imprimer,
    le distribuer, le traduire, le modifier et le réutiliser, y compris à des fins commerciales, à
    deux conditions&#160;: citer l'auteur et signaler vos modifications. La source HTML est fournie
    pour cela&#160;: ouverte dans un navigateur, elle s'imprime en PDF (format A4, marges nulles,
    arrière-plans activés).
  </p>
  <p>Pour le citer&#160;:</p>
  <p class="citation">
    {AUTEUR}, <cite>Mémento — {d.titre}</cite>, version {d.version}, {moisVersion}, {adresse},
    licence {LICENCE.nom}.
  </p>

  <p class="liens"><a href="/mementos/">← Tous les mémentos</a></p>
</Base>
